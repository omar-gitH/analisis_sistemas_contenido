# GEMINI_API_KEY: Clave de API para Google Gemini (opcional).
# En Netlify y Vercel se puede configurar en el panel de Environment Variables
# como GEMINI_API_KEY o VITE_GEMINI_API_KEY.
GEMINI_API_KEY="tu_gemini_api_key_aqui"
VITE_GEMINI_API_KEY="tu_gemini_api_key_aqui"

# APP_URL: URL donde se aloja la aplicación (opcional).
APP_URL="https://tu-sitio.netlify.app"
